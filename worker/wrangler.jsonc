{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resi-zadatak-api",
  "main": "src/index.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,

  // Production API after deployment:
  // https://resi-zadatak-api.<account-subdomain>.workers.dev/v1/interactions
  "vars": {
    "ALLOWED_ORIGINS": "https://svadme-dot.github.io",
    "UPSTREAM_TIMEOUT_MS": "120000"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_COORDINATOR",
        "class_name": "RateCoordinator"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateCoordinator"]
    }
  ]
}
